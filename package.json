{
  "name": "laro",
  "version": "1.0.0",
  "description": "LARO — landing page for a portable electronics distributor",
  "scripts": {
    "build:css": "postcss styles.css -o dist/styles.css --env production",
    "build:css:dev": "postcss styles.css -o dist/styles.css --map",
    "watch:css": "postcss styles.css -o dist/styles.css --watch --map",
    "dev": "npm run watch:css",
    "clean": "rm -rf dist/styles.css dist/styles.css.map"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "postcss": "^8.5.6",
    "postcss-cli": "^12.0.0"
  }
}
